{
  "version": 2,
  "builds": [
    {
      "src": "property_mgmt/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "property_mgmt/wsgi.py"
    }
  ],
  "functions": {
    "property_mgmt/wsgi.py": {
      "runtime": "@vercel/python",
      "installCommand": "pip install --only-binary=:all: -r requirements.txt"
    }
  }
}
